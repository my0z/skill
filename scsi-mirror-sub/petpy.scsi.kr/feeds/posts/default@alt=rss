                                            &lt;img src=&#39;https://cdn.petpy.scsi.kr/1782629365215_8gjkr.webp&#39; style=&#39;width:100% !important; height:100% !important; display:block !important; object-fit:contain !important; object-position:center center !important; background:#ffffff !important;&#39; alt=&#39;대형 메인 이미지&#39; /&gt;
                                        &lt;/div&gt;
